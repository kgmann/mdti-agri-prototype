# Copy to .env and fill in. Use letters and digits only in passwords (they go into connection URLs).

# Database
POSTGRES_PASSWORD=change-me
READONLY_DB_PASSWORD=change-me
DB_PORT=5433
# Used for local development (in Docker, the app gets these from docker-compose.yml)
DATABASE_URL=postgres://agri:change-me@localhost:5433/agri
READONLY_DATABASE_URL=postgres://readonly_assistant:change-me@localhost:5433/agri

# Shared login protecting the whole site (HTTP basic auth)
BASIC_AUTH_USER=demo
BASIC_AUTH_PASSWORD=change-me

# Gemini
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Deployment (Caddy obtains the HTTPS certificate for this domain)
APP_DOMAIN=agriprototype.lucatakpa.com
